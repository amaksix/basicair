---
layout: layouts/base.njk
pagination:
  data: collections.allProductCategories
  size: 1
  alias: category
permalink: "/{{ category.locale }}/shop/{{ category.slug }}/"
currentPage: product-category
eleventyComputed:
  locale: "{{ category.locale }}"
  pageTitle: "{{ category.title }} — BasicAir"
---
{% set categoryProducts = products | byCategory(category.slug) %}
<div class="page-title relative">
    <div class="paralaximg" data-parallax="scroll" data-image-src="{{ category.hero_image | asset | htmlBaseUrl }}"></div>
    <div class="content">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="title">{{ category.title }}</h3>
                    <ul class="breadcrumb">
                        <li><a href="/{{ locale }}/">{{ shop.breadcrumb_home }}</a></li>
                        <li><a href="/{{ locale }}/shop/">{{ shop.breadcrumb_current }}</a></li>
                        <li>{{ category.title }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="flat-spacing-2">
    <div class="container">
        {% if category.paragraphs and category.paragraphs.length %}
        <div class="row justify-center mb_40">
            <div class="col-lg-10">
                <div class="heading-section spacing-2 text-center">
                    {% for paragraph in category.paragraphs %}
                    <p class="text-body-1 text_secondary wow fadeInUp{% if not loop.last %} mb_16{% endif %}" data-wow-delay="{{ (loop.index0 * 0.1) }}s">{{ paragraph }}</p>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

        {% if categoryProducts.length %}
        {% if category.layout == "price" %}
        <div class="row g-4">
            {% for product in categoryProducts %}
            <div class="col-sm-6 col-lg-4">
                <article class="category-product-card category-product-card--price wow fadeInUp" data-wow-delay="{{ (loop.index0 * 0.05) }}s">
                    <h3 class="category-product-card__title">
                        <a href="/{{ locale }}/products/{{ product.slug }}/" class="link">{{ product.title }}</a>
                    </h3>
                    <a href="/{{ locale }}/products/{{ product.slug }}/" class="category-product-card__image img-style">
                        {% if product.image %}
                        <img class="lazyload" src="{{ product.image | asset }}" data-src="{{ product.image | asset | htmlBaseUrl }}" alt="{{ product.title }}">
                        {% endif %}
                    </a>
                    {% if product.highlights and product.highlights.length %}
                    <ul class="category-product-card__details">
                        {% for line in product.highlights %}
                        <li>{{ line }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                    {% if product.price %}
                    <p class="category-product-card__price">{{ product.price }}{% if product.price_note %} <span>{{ product.price_note }}</span>{% endif %}</p>
                    {% endif %}
                    <a href="/{{ locale }}/contact/" class="tf-btn btn-onsurface">{{ settings.labels.order }}</a>
                </article>
            </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="row g-4">
            {% for product in categoryProducts %}
            <div class="col-sm-6 {% if categoryProducts.length == 3 %}col-lg-4{% else %}col-lg-3{% endif %}">
                <a href="/{{ locale }}/products/{{ product.slug }}/" class="category-product-card hover-img wow fadeInUp" data-wow-delay="{{ (loop.index0 * 0.05) }}s">
                    <h3 class="category-product-card__title">{{ product.title }}</h3>
                    <div class="category-product-card__image img-style">
                        <img class="lazyload" src="{{ product.image | asset }}" data-src="{{ product.image | asset | htmlBaseUrl }}" alt="{{ product.title }}">
                    </div>
                    <span class="tf-btn btn-onsurface">{{ settings.labels.learn_more }} <i class="icon-arrow-up-right"></i></span>
                </a>
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% else %}
        <div class="row justify-center">
            <div class="col-lg-8">
                <div class="heading-section spacing-2 text-center">
                    {% if category.coming_soon %}
                    <p class="text-body-1 text_secondary wow fadeInUp">{{ category.coming_soon }}</p>
                    {% endif %}
                    <div class="mt_30 wow fadeInUp">
                        <a href="/{{ locale }}/contact/" class="tf-btn btn-onsurface">{{ category.cta_text }} <i class="icon-arrow-up-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</section>
