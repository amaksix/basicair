---
layout: layouts/base.njk
pagination:
  data: collections.allProductCategories
  size: 1
  alias: category
permalink: "/{{ category.locale }}/shop/{{ category.slug }}/"
currentPage: product-category
eleventyComputed:
  locale: "{{ category.locale }}"
  pageTitle: "{{ category.title }} — BasicAir"
---
<div class="page-title relative">
    <div class="paralaximg" data-parallax="scroll" data-image-src="{{ category.hero_image | asset | htmlBaseUrl }}"></div>
    <div class="content">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="title">{{ category.title }}</h3>
                    <ul class="breadcrumb">
                        <li><a href="/{{ locale }}/">{{ shop.breadcrumb_home }}</a></li>
                        <li><a href="/{{ locale }}/shop/">{{ shop.breadcrumb_current }}</a></li>
                        <li>{{ category.title }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="flat-spacing-2">
    <div class="container">
        <div class="row justify-center">
            <div class="col-lg-8">
                <div class="heading-section spacing-2">
                    <h1 class="wow fadeInUp">{{ category.title }}</h1>
                    {% if category.summary %}
                    <p class="text-body-1 text_secondary wow fadeInUp mb_16" data-wow-delay="0.05s">{{ category.summary }}</p>
                    {% endif %}
                    {% for paragraph in category.paragraphs %}
                    <p class="text-body-1 text_secondary wow fadeInUp{% if not loop.last %} mb_16{% endif %}" data-wow-delay="{{ (loop.index0 * 0.1 + 0.1) }}s">{{ paragraph }}</p>
                    {% endfor %}
                    {% if category.coming_soon %}
                    <p class="text-body-1 text_secondary wow fadeInUp mt_16" data-wow-delay="0.3s">{{ category.coming_soon }}</p>
                    {% endif %}
                    <div class="mt_30 wow fadeInUp" data-wow-delay="0.35s">
                        <a href="/{{ locale }}/contact/" class="tf-btn btn-onsurface">{{ category.cta_text }} <i class="icon-arrow-up-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
