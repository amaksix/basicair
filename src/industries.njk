---
layout: layouts/base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale }}/industries/"
currentPage: industries
eleventyComputed:
  pageTitle: "{{ industries.title }}"
---
{% set topMarkets = industryMarkets | byParent("") %}
<div class="page-title relative">
    <div class="paralaximg" data-parallax="scroll" data-image-src="{{ industries.hero_image | asset | htmlBaseUrl }}"></div>
    <div class="content">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="title">{{ industries.hero_title }}</h3>
                    <ul class="breadcrumb">
                        <li><a href="/{{ locale }}/">{{ industries.breadcrumb_home }}</a></li>
                        <li>{{ industries.breadcrumb_current }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="flat-spacing-2">
    <div class="container">
        <div class="row justify-center">
            <div class="col-lg-8">
                <div class="heading-section text-center spacing-2">
                    <h1 class="wow fadeInUp">{{ industries.main_heading }}</h1>
                    <p class="text-body-1 text_secondary wow fadeInUp" data-wow-delay="0.1s">{{ industries.main_intro }}</p>
                </div>
            </div>
        </div>

        {% if topMarkets and topMarkets.length %}
        <div class="row g-4 justify-center">
            {% for market in topMarkets %}
            <div class="col-md-6 col-lg-5">
                <div class="collection-position hover-img style-4 wow fadeInUp" data-wow-delay="{{ (loop.index0 * 0.1) }}s">
                    <a href="/{{ locale }}/industries/{{ market.slug }}/" class="img-style">
                        <img class="lazyload" src="{{ market.image | asset }}" data-src="{{ market.image | asset | htmlBaseUrl }}" alt="{{ market.title }}">
                    </a>
                    <div class="content cls-content">
                        <h4><a href="/{{ locale }}/industries/{{ market.slug }}/" class="link">{{ market.title }}</a></h4>
                        {% if market.summary %}
                        <h6>{{ market.summary }}</h6>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
