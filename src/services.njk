---
layout: layouts/base.njk
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "/{{ locale }}/services/"
currentPage: services
eleventyComputed:
  pageTitle: "{{ services.title }}"
---
<div class="page-title relative">
    <div class="paralaximg" data-parallax="scroll" data-image-src="{{ services.hero_image | asset }}"></div>
    <div class="content">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="title">{{ services.hero_title }}</h3>
                    <ul class="breadcrumb">
                        <li><a href="/{{ locale }}/">{{ services.breadcrumb_home }}</a></li>
                        <li>{{ services.breadcrumb_current }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="flat-spacing-2 about-us-main pb-0">
    <div class="container">
        <div class="row justify-center">
            <div class="col-lg-8">
                <div class="heading-section text-center spacing-2">
                    <h1 class="wow fadeInUp">{{ services.main_heading }}</h1>
                    <p class="text-body-1 text_secondary wow fadeInUp" data-wow-delay="0.1s">{{ services.main_intro }}</p>
                </div>
            </div>
            <div class="col-12">
                <div class="img-wrap">
                    <img class="lazyload effect-paralax" src="{{ services.main_image | asset }}" data-src="{{ services.main_image | asset }}" alt="{{ services.main_heading }}">
                </div>
                <div class="main-content">
                    <div class="left">
                        <h3 class="mb_11 wow fadeInUp">{{ services.mission.title }}</h3>
                        <p class="text_secondary text-body-1 wow fadeInUp" data-wow-delay="0.1s">{{ services.mission.text }}</p>
                    </div>
                    <div class="right">
                        <h3 class="mb_11 wow fadeInUp">{{ services.vision.title }}</h3>
                        <p class="text_secondary text-body-1 wow fadeInUp" data-wow-delay="0.1s">{{ services.vision.text }}</p>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div dir="ltr" class="swiper tf-sw-iconbox" data-preview="4" data-tablet="3" data-mobile-sm="2" data-mobile="1" data-space-lg="30" data-space-md="30" data-space="15" data-pagination="1" data-pagination-sm="2" data-pagination-md="3" data-pagination-lg="4">
                    <div class="swiper-wrapper">
                        {% for feature in services.features %}
                        <div class="swiper-slide">
                            <div class="tf-box-icon">
                                <div class="icon"><i class="{{ feature.icon }}"></i></div>
                                <div class="content">
                                    <h5 class="title">{{ feature.title }}</h5>
                                    <p>{{ feature.description }}</p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="sw-pagination-iconbox sw-dots type-circle d-flex justify-content-center"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="flat-spacing-2 about-us">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="img-style">
                    <img class="lazyload" src="{{ services.about_section.image | asset }}" alt="{{ services.about_section.heading }}">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="box-about">
                    <div class="heading-section spacing-3">
                        <h3 class="wow fadeInUp">{{ services.about_section.heading }}</h3>
                        <p class="text-body-1 text_secondary wow fadeInUp" data-wow-delay="0.1s">{{ services.about_section.text }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
